# ── DealGuard MY: server configuration ───────────────────────────────
# 1 = demo mode (replays a sample analysis, no AWS needed). Set to 0 once Bedrock is connected.
DEALGUARD_DEMO=1

# Bedrock region. ap-southeast-1 (Singapore) serves Claude via the global endpoint.
BEDROCK_REGION=ap-southeast-1

# Claude model on Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5

# Which Bedrock API to call:
#   mantle  (default) Messages API endpoint, model IDs like anthropic.claude-sonnet-5-5
#   runtime classic endpoint, for regions without Mantle such as Malaysia (ap-southeast-5).
#           Use an inference profile as the model, e.g. global.anthropic.claude-sonnet-5-5
# Malaysia sandbox example: BEDROCK_REGION=ap-southeast-5, BEDROCK_ENDPOINT=runtime,
#                           BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
BEDROCK_ENDPOINT=mantle

# Auth option A (quickest, local dev): a Bedrock API key from the Bedrock console.
# Leave empty to use option B: your normal AWS credentials (aws configure / SSO / IAM role).
BEDROCK_API_KEY=

# Auth option C (Vercel): IAM role assumed with Vercel's OIDC token, no stored secret.
# Used when BEDROCK_API_KEY is empty. See "Vercel" in BEDROCK_SETUP.md.
# BEDROCK_ROLE_ARN=arn:aws:iam::123456789012:role/dealguard-vercel

# Model: haiku (default, BEDROCK_HAIKU_MODEL_ID), sonnet (BEDROCK_MODEL_ID)
# or gemini (testing only: no citations, no caching). Keys: GEMINI_API_KEY, _2, _3
# Outside production the header has a picker that switches between them per browser, no restart.
# LLM_PROVIDER=haiku
# BEDROCK_HAIKU_MODEL_ID=global.anthropic.claude-haiku-5-5
# GEMINI_MODEL_ID=gemini-3.1-flash-lite
# GEMINI_API_KEY=
# Set to 1 to show the model picker in a production build too (keep off for real users).
# ALLOW_MODEL_SWITCH=0
